<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         fx:controller="org.cdg.controller.DashboardController"
         tabClosingPolicy="UNAVAILABLE"
         prefWidth="1100" prefHeight="720">

    <!-- ABA 1: DASHBOARD PRINCIPAL -->
    <Tab text="Dashboard Principal">
        <VBox spacing="16" style="-fx-padding: 20; -fx-background-color: #1e1f22;">

            <!-- TOPO: RESUMO FINANCEIRO + CARDS DE METAS EM CÍRCULO -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <!-- CARDS DE SALDO -->
                <HBox spacing="12" HBox.hgrow="ALWAYS">
                    <!-- CARD 1: SOBRA DO MÊS -->
                    <VBox styleClass="card-resumo" alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Sobra do Mês" style="-fx-text-fill: #9da5b4; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblSobra" text="R$ 0,00" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                        <Button fx:id="btnInvestirSobra" text="✨ Investir Sobra" onAction="#investirSobra" visible="false" managed="false"
                                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;"/>
                    </VBox>

                    <!-- CARD 2: DESPESAS DO MÊS -->
                    <VBox styleClass="card-resumo" alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Despesas do Mês" style="-fx-text-fill: #9da5b4; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblDeficit" text="R$ 0,00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f75454;"/>
                    </VBox>

                    <!-- CARD 3: A REEMBOLSAR -->
                    <VBox styleClass="card-resumo" alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="A Reembolsar" style="-fx-text-fill: #9da5b4; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblReembolso" text="R$ 0,00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e5c07b;"/>
                    </VBox>

                    <!-- CARD 4: TOTAL INVESTIDO -->
                    <VBox styleClass="card-resumo" alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Total Investido" style="-fx-text-fill: #9da5b4; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblInvestido" text="R$ 0,00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #61afef;"/>
                    </VBox>
                </HBox>

                <!-- PAINEL CIRCULAR DE METAS (TOPO DIREITO) -->
                <VBox spacing="4" style="-fx-background-color: #2b2d30; -fx-padding: 8 12; -fx-background-radius: 8; -fx-border-color: #3c3f41; -fx-border-radius: 8;">
                    <Label text="🎯 Metas de Investimento" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #bcbec4;"/>
                    <ScrollPane fitToHeight="true" prefHeight="65" prefWidth="320" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <HBox fx:id="boxCardsMetas" spacing="12" alignment="CENTER_LEFT"/>
                    </ScrollPane>
                </VBox>
            </HBox>

            <!-- SEÇÃO DE BLOCOS HORIZONTAIS COM BOTÕES DE CADASTRO RÁPIDO -->
            <VBox spacing="14">
                <!-- BLOCO 1: GASTOS POR CATEGORIA -->
                <VBox spacing="6" style="-fx-background-color: #2b2d30; -fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: #3c3f41; -fx-border-radius: 8;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🏷️ Gastos por Categoria" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Nova Categoria" onAction="#criarNovaCategoriaRapida" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;"/>
                    </HBox>
                    <ScrollPane fitToHeight="true" prefHeight="75" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <HBox fx:id="boxGastosCategorias" spacing="12" alignment="CENTER_LEFT"/>
                    </ScrollPane>
                </VBox>

                <!-- BLOCO 2: FATURAS POR CARTÃO -->
                <VBox spacing="6" style="-fx-background-color: #2b2d30; -fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: #3c3f41; -fx-border-radius: 8;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="💳 Faturas por Cartão" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Novo Cartão" onAction="#criarNovoCartaoRapido" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 4;"/>
                    </HBox>
                    <ScrollPane fitToHeight="true" prefHeight="75" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <HBox fx:id="boxFaturasCartoes" spacing="12" alignment="CENTER_LEFT"/>
                    </ScrollPane>
                </VBox>
            </VBox>

            <!-- NAVEGAÇÃO E AÇÕES DA TABELA -->
            <HBox spacing="12" alignment="CENTER">
                <Button text="‹ Mês Anterior" onAction="#mesAnterior" style="-fx-cursor: hand; -fx-background-color: #2b2d30; -fx-text-fill: #bcbec4;"/>
                <Label fx:id="lblMesAno" text="09 / 2026" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                <Button text="Próximo Mês ›" onAction="#mesSeguinte" style="-fx-cursor: hand; -fx-background-color: #2b2d30; -fx-text-fill: #bcbec4;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="📄 PDF Reembolsos" onAction="#gerarRelatorioReembolsos" style="-fx-background-color: #e5c07b; -fx-text-fill: #1e1f22; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="+ Nova Transação" onAction="#abrirFormulario" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Editar Selecionado" onAction="#editarTransacao" style="-fx-background-color: #3574f0; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button text="Excluir Selecionado" onAction="#excluirTransacao" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>

            <!-- TABELA DE TRANSAÇÕES -->
            <TableView fx:id="tabelaTransacoes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colData" text="Data Cobrança" prefWidth="120"/>
                    <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="280"/>
                    <TableColumn fx:id="colCartao" text="Cartão" prefWidth="140"/>
                    <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="140"/>
                    <TableColumn fx:id="colValor" text="Valor" prefWidth="130"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </Tab>

    <!-- ABA 2: MEUS CARTÕES -->
    <Tab text="Meus Cartões">
        <HBox spacing="20" style="-fx-padding: 20;">
            <VBox spacing="15" prefWidth="300" style="-fx-padding: 20; -fx-background-color: #2b2d30; -fx-background-radius: 8;">
                <Label text="Gerir Cartão" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Nome (ex: Nubank, Itaú):"/>
                <TextField fx:id="txtNomeCartao" promptText="Nome do Cartão"/>
                <Label text="Dia de Vencimento (1 a 31):"/>
                <TextField fx:id="txtDiaVencimento" promptText="Ex: 10"/>
                <HBox spacing="10">
                    <Button text="Salvar / Atualizar" onAction="#salvarCartao" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Excluir" onAction="#excluirCartao" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
            <TableView fx:id="tabelaCartoes" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCartaoNome" text="Nome do Cartão" prefWidth="300"/>
                    <TableColumn fx:id="colCartaoVencimento" text="Dia de Vencimento" prefWidth="150"/>
                </columns>
            </TableView>
        </HBox>
    </Tab>

    <!-- ABA 3: CONFIGURAR CATEGORIAS -->
    <Tab text="Configurar Categorias">
        <HBox spacing="20" style="-fx-padding: 20;">
            <VBox spacing="15" prefWidth="300" style="-fx-padding: 20; -fx-background-color: #2b2d30; -fx-background-radius: 8;">
                <Label text="Gerir Categoria" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Nome da Categoria:"/>
                <TextField fx:id="txtNomeCategoria" promptText="Nome da Categoria"/>
                <HBox spacing="10">
                    <Button text="Salvar / Atualizar" onAction="#salvarCategoria" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Excluir" onAction="#excluirCategoria" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
            <TableView fx:id="tabelaCategorias" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCategoriaNome" text="Nome da Categoria" prefWidth="400"/>
                </columns>
            </TableView>
        </HBox>
    </Tab>

    <!-- ABA 4: METAS DE INVESTIMENTO -->
    <Tab text="Metas de Investimento">
        <HBox spacing="20" style="-fx-padding: 20;">
            <VBox spacing="15" prefWidth="300" style="-fx-padding: 20; -fx-background-color: #2b2d30; -fx-background-radius: 8;">
                <Label text="Gerir Meta" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Descrição da Meta:"/>
                <TextField fx:id="txtDescricaoMeta" promptText="Ex: Reserva de Emergência"/>
                <Label text="Valor Alvo (R$):"/>
                <TextField fx:id="txtValorAlvoMeta" promptText="Ex: 10000.00"/>
                <Label text="Data Limite:"/>
                <TextField fx:id="txtDataLimiteMeta" promptText="DD/MM/AAAA"/>
                <HBox spacing="10">
                    <Button text="Salvar / Atualizar" onAction="#salvarMeta" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Excluir" onAction="#excluirMeta" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
            <TableView fx:id="tabelaMetas" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMetaDescricao" text="Descrição da Meta" prefWidth="300"/>
                    <TableColumn fx:id="colMetaAlvo" text="Valor Alvo" prefWidth="150"/>
                    <TableColumn fx:id="colMetaProgresso" text="Progresso" prefWidth="250"/>
                </columns>
            </TableView>
        </HBox>
    </Tab>
</TabPane>