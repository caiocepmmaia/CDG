<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" style="-fx-background-color: #191a1c;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cdg.controller.DashboardController">
    <padding>
        <Insets top="15" right="20" bottom="15" left="20"/>
    </padding>

    <!-- CABEÇALHO E NAVEGAÇÃO DO MÊS -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Dashboard Financeiro" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #212225; -fx-padding: 4 10; -fx-background-radius: 6;">
            <Button text="◀" onAction="#mesAnterior" style="-fx-background-color: transparent; -fx-text-fill: #9da5b4; -fx-cursor: hand;"/>
            <Label fx:id="lblMesAno" text="09 / 2026" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
            <Button text="▶" onAction="#mesSeguinte" style="-fx-background-color: transparent; -fx-text-fill: #9da5b4; -fx-cursor: hand;"/>
        </HBox>
    </HBox>

    <!-- SEÇÃO SUPERIOR (LADO A LADO): RESUMO MENSAL + METAS + CARTÕES -->
    <HBox spacing="12">
        <!-- 1. CARD RESUMO MENSAL -->
        <VBox spacing="10" prefWidth="270" minWidth="270" style="-fx-background-color: #212225; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #37393e; -fx-border-radius: 8;">
            <Label text="RESUMO DO MÊS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9da5b4;"/>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Sobra do Mês" style="-fx-font-size: 10px; -fx-text-fill: #9da5b4;"/>
                    <Label fx:id="lblSobra" text="R$ 0,00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #00c853;"/>
                </VBox>
                <Button fx:id="btnInvestirSobra" text="✨ Investir Sobra" onAction="#investirSobra" style="-fx-background-color: #3574f0; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"/>
            </HBox>

            <Separator style="-fx-opacity: 0.15;"/>

            <HBox spacing="15">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Despesas" style="-fx-font-size: 10px; -fx-text-fill: #9da5b4;"/>
                    <Label fx:id="lblDeficit" text="R$ 0,00" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #f75454;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="A Reembolsar" style="-fx-font-size: 10px; -fx-text-fill: #9da5b4;"/>
                    <Label fx:id="lblReembolso" text="R$ 0,00" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #ffb74d;"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- 2. PAINEL DE METAS (ALTURA AJUSTADA PARA ELIMINAR SCROLL VERTICAL) -->
        <VBox spacing="6" prefWidth="480" minWidth="450" style="-fx-background-color: #212225; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #37393e; -fx-border-radius: 8;">
            <Label text="MINHAS METAS E OBJETIVOS" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9da5b4;"/>
            <ScrollPane fitToHeight="true" fitToWidth="false" minHeight="105" prefHeight="105" maxHeight="105" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0 0 4 0;" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED">
                <HBox fx:id="boxCardsMetas" spacing="10" alignment="CENTER_LEFT"/>
            </ScrollPane>
        </VBox>

        <!-- 3. FATURAS POR CARTÃO (ACOMODA 6 CARTÕES) -->
        <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color: #212225; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #37393e; -fx-border-radius: 8;">
            <Label text="💳 Faturas por Cartão" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9da5b4;"/>
            <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="75" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED">
                <HBox fx:id="boxFaturasCartoes" spacing="10" alignment="CENTER_LEFT"/>
            </ScrollPane>
        </VBox>
    </HBox>

    <!-- FAIXA HORIZONTAL DE CATEGORIAS (SEM SCROLL MÍNIMO INTERNO) -->
    <VBox spacing="6" style="-fx-background-color: #212225; -fx-padding: 10 12; -fx-background-radius: 8; -fx-border-color: #37393e; -fx-border-radius: 8;">
        <Label text="🏷️ Gastos por Categoria" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #9da5b4;"/>
        <ScrollPane fitToHeight="true" fitToWidth="true" minHeight="65" prefHeight="65" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED">
            <HBox fx:id="boxGastosCategorias" spacing="10" alignment="CENTER_LEFT"/>
        </ScrollPane>
    </VBox>

    <!-- ABAS SECUNDÁRIAS -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <!-- ABA TRANSAÇÕES DO MÊS -->
        <Tab text="Transações do Mês">
            <VBox spacing="8" style="-fx-padding: 8 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="+ Nova Transação" onAction="#abrirFormulario" style="-fx-background-color: #3574f0; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button text="✏ Editar" onAction="#editarTransacao" style="-fx-background-color: #2b2d30; -fx-text-fill: white; -fx-cursor: hand;"/>
                    <Button text="🗑 Excluir" onAction="#excluirTransacao" style="-fx-background-color: #2b2d30; -fx-text-fill: #f75454; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="📄 PDF Reembolsos" onAction="#gerarRelatorioReembolsos" style="-fx-background-color: #2b2d30; -fx-text-fill: #ffb74d; -fx-cursor: hand;"/>
                </HBox>

                <TableView fx:id="tabelaTransacoes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDataCompra" text="Data Compra" prefWidth="100"/>
                        <TableColumn fx:id="colData" text="Data Cobrança" prefWidth="100"/>
                        <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="200"/>
                        <TableColumn fx:id="colCartao" text="Cartão" prefWidth="120"/>
                        <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="120"/>
                        <TableColumn fx:id="colValor" text="Valor" prefWidth="120"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- ABA GERIR CARTÕES -->
        <Tab text="Cartões">
            <VBox spacing="8" style="-fx-padding: 8 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtNomeCartao" promptText="Nome do Cartão (ex: Nubank)"/>
                    <TextField fx:id="txtDiaVencimento" promptText="Dia Vencimento (1-31)" prefWidth="150"/>
                    <!-- NOVO CAMPO ADICIONADO AQUI: -->
                    <TextField fx:id="txtDiaFechamento" promptText="Dia Fechamento (1-31)" prefWidth="150"/>
                    <Button text="Salvar Cartão" onAction="#salvarCartao" style="-fx-background-color: #3574f0; -fx-text-fill: white; -fx-cursor: hand;"/>
                    <Button text="Excluir Cartão" onAction="#excluirCartao" style="-fx-background-color: #2b2d30; -fx-text-fill: #f75454; -fx-cursor: hand;"/>
                </HBox>

                <TableView fx:id="tabelaCartoes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCartaoNome" text="Nome do Cartão" prefWidth="200"/>
                        <TableColumn fx:id="colCartaoVencimento" text="Dia do Vencimento" prefWidth="150"/>
                        <!-- NOVA COLUNA ADICIONADA AQUI: -->
                        <TableColumn fx:id="colCartaoFechamento" text="Dia do Fechamento" prefWidth="150"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- ABA GERIR CATEGORIAS -->
        <Tab text="Categorias">
            <VBox spacing="8" style="-fx-padding: 8 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtNomeCategoria" promptText="Nome da Categoria (ex: Alimentação)"/>
                    <Button text="Salvar Categoria" onAction="#salvarCategoria" style="-fx-background-color: #3574f0; -fx-text-fill: white; -fx-cursor: hand;"/>
                    <Button text="Excluir Categoria" onAction="#excluirCategoria" style="-fx-background-color: #2b2d30; -fx-text-fill: #f75454; -fx-cursor: hand;"/>
                </HBox>

                <TableView fx:id="tabelaCategorias" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCategoriaNome" text="Nome da Categoria" prefWidth="300"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- ABA GERIR METAS -->
        <Tab text="Gerenciar Metas">
            <VBox spacing="8" style="-fx-padding: 8 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtDescricaoMeta" promptText="Descrição (ex: Moto, Emergência)"/>
                    <TextField fx:id="txtValorAlvoMeta" promptText="Valor Objetivo (R$)" prefWidth="150"/>
                    <TextField fx:id="txtDataLimiteMeta" promptText="Data Limite (DD/MM/AAAA)" prefWidth="180"/>
                    <Button text="Salvar Meta" onAction="#salvarMeta" style="-fx-background-color: #3574f0; -fx-text-fill: white; -fx-cursor: hand;"/>
                    <Button text="Excluir Meta" onAction="#excluirMeta" style="-fx-background-color: #2b2d30; -fx-text-fill: #f75454; -fx-cursor: hand;"/>
                </HBox>

                <TableView fx:id="tabelaMetas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMetaDescricao" text="Objetivo" prefWidth="200"/>
                        <TableColumn fx:id="colMetaAlvo" text="Valor Objetivo" prefWidth="150"/>
                        <TableColumn fx:id="colMetaProgresso" text="Progresso Acumulado" prefWidth="300"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>
</VBox>